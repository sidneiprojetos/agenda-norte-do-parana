{
  "entities": {
    "users": {
      "title": "Usuários - Agenda Norte do Paraná",
      "description": "Perfis de usuários que acessam a Agenda Norte do Paraná via Google/Gmail",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" },
        "division": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["email", "role", "status"]
    },
    "notes": {
      "title": "Anotações - Agenda Norte do Paraná",
      "description": "Eventos e anotações compartilhadas da Agenda Norte do Paraná",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" }
      },
      "required": ["title", "date", "createdAt", "authorEmail"]
    },
    "auditLogs": {
      "title": "Log de Auditoria - Agenda Norte do Paraná",
      "description": "Trilha de auditoria com quem criou, editou, excluiu, visualizou anotações e os acessos ao sistema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete", "view", "login", "logout", "export", "import", "reset", "approve", "reject", "block", "user_update", "user_delete"]
        },
        "entityType": { "type": "string", "enum": ["note", "user", "auth", "data"] },
        "entityId": { "type": "string" },
        "entityTitle": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorEmail": { "type": "string" },
        "details": { "type": "string" },
        "expireAt": { "type": "timestamp", "description": "Timestamp used for app-level TTL cleanup (180 dias). Quando billing estiver habilitado, pode ser ativado TTL nativo nesta coleção." },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "entityType", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Perfil de usuário"
    },
    "/notes/{noteId}": {
      "schema": "notes",
      "description": "Anotação da agenda compartilhada"
    },
    "/auditLogs/{logId}": {
      "schema": "auditLogs",
      "description": "Evento de auditoria (append-only)"
    }
  }
}
