rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user has unrestricted administrator access
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)imc\\.sidnei@g(a)?mail\\.com') ||
        request.auth.token.email == 'imc.sidnei@gmail.com' ||
        request.auth.token.email == 'imc.sidnei@gamil.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Check if user is approved member or admin
    function isApproved() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved')
      );
    }
    
    // Admins collection: verified admins can read and write
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Users collection:
    // - Authenticated users can read users (for profile sync and admin dashboard)
    // - Authenticated users can create their own profile
    // - Admins can update any user, or users can update their own non-privileged data
    // - Only admins can delete user records
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      );
      allow delete: if isAdmin();
    }
    
    // Notes collection (Agenda Norte do Paraná):
    // Only approved members and administrators can read, create, and modify notes.
    // Deleting notes is restricted to Admins or authors.
    match /notes/{noteId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved();
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.createdBy == request.auth.token.email ||
          resource.data.authorEmail == request.auth.token.email ||
          resource.data.authorId == request.auth.uid
        )
      );
    }
  }
}
