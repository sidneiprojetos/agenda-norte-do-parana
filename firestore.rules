rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if authenticated with Google
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user's profile (users/{uid}) has the admin role
    function isMemberAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if user is an administrator (master email or promoted admin)
    function isAdmin() {
      return request.auth.token.email == 'imc.sidnei@gmail.com' || isMemberAdmin();
    }
    
    // Check if the requesting user owns the given resource
    function isOwner(resource) {
      return isAuthenticated() &&
        (resource.data.authorId == request.auth.uid ||
         resource.data.authorEmail == request.auth.token.email);
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can only create their own profile (registration)
      allow create: if isAuthenticated() && request.auth.uid == userId && request.auth.uid == request.resource.data.uid;
      // Users can update their own profile; admins can approve/reject/edit anyone
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }
    
    // Notes collection (Agenda Norte do Paraná)
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      // Any authenticated user publishes notes to the shared agenda
      allow create: if isAuthenticated();
      // Only the author or an admin can update or delete
      allow update, delete: if isAdmin() || isOwner(resource);
    }
    
    // Divisions collection (administrator manages the divisions used by notes)
    match /divisions/{divisionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // App metadata (e.g. one-time seed flag for initial divisions)
    match /appMeta/{metaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit logs collection - append-only write, readable by admins, deletable by admins for TTL cleanup
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      // Admins can delete expired logs (client-side cleanup triggered when AuditDashboard opens)
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}